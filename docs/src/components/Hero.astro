---
import TwinScreens from './TwinScreens.astro';
import { withBase } from '../lib/paths';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-intro">
    <div class="hero-copy">
      <p class="kicker hero-kicker"><span class="live-dot" aria-hidden="true"></span> The shared screen for Jellyfin</p>
      <h1 id="hero-title">Your movie night. <span>Everyone in sync.</span></h1>
    </div>
    <div class="hero-support">
      <p class="hero-description">Different places, the same scene. Bring your friends into Jellyfin, press play, and share every pause, plot twist and conversation.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
        <a class="button button-ghost" href={withBase('/product/first-watch-party/')}>Follow the tutorial <span aria-hidden="true">→</span></a>
        <span class="hero-note">Free &amp; open source</span>
      </div>
    </div>
  </div>
  <TwinScreens />
</section>
