<section class="promise-strip" aria-label="Highlights">
  <div class="promise-inner">
    <div class="promise-item">
      <span class="promise-icon" style="--accent:#27c8f7;--float-delay:0s" aria-hidden="true"><svg viewBox="0 0 24 24" class="filled"><use href="#demo-play"/></svg></span>
      <p>Press play together</p>
    </div>
    <div class="promise-item">
      <span class="promise-icon" style="--accent:#8fa6f8;--float-delay:.6s" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#demo-chat"/></svg></span>
      <p>Talk while you watch</p>
    </div>
    <div class="promise-item">
      <span class="promise-icon" style="--accent:#ad7aff;--float-delay:1.2s" aria-hidden="true"><svg viewBox="0 0 24 24" class="filled"><use href="#demo-next"/></svg></span>
      <p>Keep the next episode ready</p>
    </div>
  </div>
</section>
