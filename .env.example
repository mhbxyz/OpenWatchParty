# ============================================================================
# OpenWatchParty - Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values as needed.
# Production deployments must configure JWT_SECRET.
# ============================================================================

# ----------------------------------------------------------------------------
# Network Ports
# ----------------------------------------------------------------------------

# Jellyfin web UI port (default: 8096)
JELLYFIN_PORT=8096

# WebSocket session server port (default: 3000)
SESSION_SERVER_PORT=3000

# ----------------------------------------------------------------------------
# Media Configuration
# ----------------------------------------------------------------------------

# Path to your media directory (Movies)
# Default: ~/Videos/Movies
MEDIA_DIR=${HOME}/Videos/Movies

# ----------------------------------------------------------------------------
# Session Server
# ----------------------------------------------------------------------------

# Bind address for the session server (default: 0.0.0.0)
# HOST=0.0.0.0

# Internal port for the session server (default: 3000)
# PORT=3000

# Comma-separated list of allowed CORS origins
# Must match your Jellyfin URL(s) for WebSocket connections to work
ALLOWED_ORIGINS=http://localhost:8096,https://localhost:8096

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------

# JWT secret for session authentication
# For production, use Base64 generated from at least 32 random bytes
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Explicitly allow unauthenticated development when JWT_SECRET is empty.
# Never enable this in production.
ALLOW_INSECURE_NO_AUTH=true

# JWT token time-to-live in seconds (default: 3600 = 1 hour)
# TOKEN_TTL=3600

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------

# Disable colored output in Makefile (set to any value to disable)
# NO_COLOR=1

# User/Group IDs for Docker volume permissions (auto-detected)
# UID=1000
# GID=1000
