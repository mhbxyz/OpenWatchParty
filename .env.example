# ============================================================================
# OpenWatchParty - Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values as needed.
# Production deployments must configure JWT_SECRET.
# ============================================================================

# ----------------------------------------------------------------------------
# Network Ports
# ----------------------------------------------------------------------------

# Jellyfin web UI port (default: 8096)
JELLYFIN_PORT=8096

# WebSocket session server port (default: 3000)
SESSION_SERVER_PORT=3000

# ----------------------------------------------------------------------------
# Media Configuration
# ----------------------------------------------------------------------------

# Path to your media directory (Movies)
# Default: ~/Videos/Movies
MEDIA_DIR=${HOME}/Videos/Movies

# ----------------------------------------------------------------------------
# Session Server
# ----------------------------------------------------------------------------

# Bind address for the session server (default: 0.0.0.0)
# HOST=0.0.0.0

# Internal port for the session server (default: 3000)
# PORT=3000

# Comma-separated list of allowed CORS origins
# Must match your Jellyfin URL(s) for WebSocket connections to work
ALLOWED_ORIGINS=http://localhost:8096,https://localhost:8096

# Concurrent WebSocket connection limits (global and per effective client IP)
MAX_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=32

# Comma-separated proxy IPs or CIDRs allowed to supply X-Forwarded-For.
# Leave empty when connecting directly; example: 127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXIES=

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------

# JWT secret for session authentication
# For production, use Base64 generated from at least 32 random bytes
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Authentication mode: hs256 (legacy), hybrid (migration), asymmetric (recommended after pairing)
JWT_AUTH_MODE=hs256

# Required for hybrid/asymmetric mode. owpctl manages this file automatically.
JWT_TRUST_STORE_PATH=/var/lib/openwatchparty/trust-store.json
OWP_TRUST_STORE_DIR=./trust

# Explicitly allow unauthenticated development when JWT_SECRET is empty.
# Never enable this in production.
ALLOW_INSECURE_NO_AUTH=true

# Seconds allowed for the first successful auth message when JWT is enabled.
# This deadline does not apply in insecure mode.
AUTH_TIMEOUT_SECONDS=10

# JWT token time-to-live in seconds (default: 3600 = 1 hour)
# TOKEN_TTL=3600

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------

# Disable colored output in Makefile (set to any value to disable)
# NO_COLOR=1

# User/Group IDs for Docker volume permissions (auto-detected)
# UID=1000
# GID=1000
