<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>OpenWatchParty.Plugin.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ClientSourceDir>$(MSBuildProjectDirectory)\..\..\..\clients\jellyfin-web</ClientSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Jellyfin dependencies for testing -->
    <PackageReference Include="Jellyfin.Model" Version="10.11.5" />
    <PackageReference Include="Jellyfin.Controller" Version="10.11.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenWatchParty\OpenWatchPartyPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ClientSourceDir)\plugin.js"
                      Condition="Exists('$(ClientSourceDir)')"
                      LogicalName="OpenWatchParty.Plugin.Tests.Fixtures.plugin.js" />
    <EmbeddedResource Include="..\OpenWatchParty\Web\plugin.js"
                      Condition="!Exists('$(ClientSourceDir)')"
                      LogicalName="OpenWatchParty.Plugin.Tests.Fixtures.plugin.js" />
  </ItemGroup>
</Project>
